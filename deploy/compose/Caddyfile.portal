# Portal + subscription front for the vlr-main-agent, gated by Authentik via a
# DEDICATED proxy outpost (ak-proxy) running on THIS host.
#
# Why a dedicated outpost: the official Authentik forward_auth talks directly to
# an outpost on :9000. Going through the remote EDGE Caddy to the embedded outpost
# mangles X-Forwarded-Host (the header the outpost uses to match the application),
# so it 404s. The local ak-proxy avoids that extra hop; it connects OUTBOUND to
# Authentik for its config, so no inbound headers get rewritten.
#
# Routing:
#   /sub/*                    public — the subscription URL clients poll (token = secret)
#   /v1/*                     public path, token-guarded by the agent itself
#   /outpost.goauthentik.io/* the outpost's own login/callback endpoints -> ak-proxy
#   everything else           forward-auth via ak-proxy -> agent /me portal (QR + link)
#
# Required env (compose passes it): PORTAL_DOMAIN.

{$PORTAL_DOMAIN} {
	encode gzip

	handle /sub/* {
		reverse_proxy agent:8443
	}

	handle /v1/* {
		reverse_proxy agent:8443
	}

	# The outpost's own endpoints (login redirect + callback) must be reachable
	# without prior auth.
	handle /outpost.goauthentik.io/* {
		reverse_proxy ak-proxy:9000
	}

	# Everything else = the portal, gated by Authentik forward-auth.
	handle {
		forward_auth ak-proxy:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			# Capitalization matters — otherwise the copied headers arrive empty.
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
			trusted_proxies private_ranges
		}
		# The portal handler ignores the path; normalize everything to /me.
		rewrite * /me
		reverse_proxy agent:8443
	}
}

# Copy to .env next to docker-compose.yml and fill in. `docker compose` reads it
# automatically. NEVER commit the real .env.

# --- agent ---
# Bearer token guarding the management API (POST/DELETE /v1/users, /v1/nodes).
# Generate: openssl rand -hex 24
AGENT_API_TOKEN=
# Host port the agent API is published on.
AGENT_PORT=8443

# Domain for the optional TLS terminator (compose --profile tls). With a real
# domain (A-record -> this box) + reachable port 80, Caddy fetches a Let's
# Encrypt cert automatically.
AGENT_DOMAIN=localhost
# HTTPS port Caddy serves on. Default 443. Set to a free port (e.g. 9443) when
# 443 is already used on the host (e.g. an mtg/MTProto proxy) — ACME still
# validates over port 80, so the cert is real. The agent URL becomes
# https://AGENT_DOMAIN:AGENT_HTTPS_PORT.
AGENT_HTTPS_PORT=443

# --- agent -> node TLS trust ---
# Nodes' user/pull API behind a self-signed or internal CA:
#   NODE_CA_FILE=/etc/vlr/node-ca.pem   (mount the bundle into the agent), or
#   NODE_TLS_INSECURE=1                 (skip verification — lab only)
NODE_CA_FILE=
NODE_TLS_INSECURE=0

# --- PostgreSQL (keys/users) ---
POSTGRES_USER=vlr
POSTGRES_PASSWORD=
POSTGRES_DB=vlr

# --- ClickHouse (metrics) ---
CLICKHOUSE_DB=vlr
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- subscription presentation (what clients show) ---
# Default overall name (Profile-Title). Supports Cyrillic + emoji (the emoji acts
# as the "icon"). Per-user `title` on create overrides this.
AGENT_SUB_TITLE=🎓 Обучение у Александры Олейник
# How often the client re-fetches the subscription (hours).
AGENT_SUB_UPDATE_HOURS=12
# Optional support link shown in the client.
AGENT_SUB_SUPPORT_URL=

# --- delta-pull tuning (optional) ---
PULL_THRESHOLD_BYTES=268435456
RECONCILE_SECONDS=600
DOWN_AFTER_MISSES=3

# Copy to .env next to docker-compose.yml and fill in. `docker compose` reads it
# automatically. NEVER commit the real .env.

# --- agent ---
# Bearer token guarding the management API (POST/DELETE /v1/users, /v1/nodes).
# Generate: openssl rand -hex 24
AGENT_API_TOKEN=
# Host port the agent API is published on.
AGENT_PORT=8443

# Domain for the optional TLS terminator (compose --profile tls). With a real
# domain (A-record -> this box) + reachable port 80, Caddy fetches a Let's
# Encrypt cert automatically.
AGENT_DOMAIN=localhost
# HTTPS port Caddy serves on. Default 443. Set to a free port (e.g. 9443) when
# 443 is already used on the host (e.g. an mtg/MTProto proxy) — ACME still
# validates over port 80, so the cert is real. The agent URL becomes
# https://AGENT_DOMAIN:AGENT_HTTPS_PORT.
AGENT_HTTPS_PORT=443

# --- agent -> node TLS trust ---
# Nodes' user/pull API behind a self-signed or internal CA:
#   NODE_CA_FILE=/etc/vlr/node-ca.pem   (mount the bundle into the agent), or
#   NODE_TLS_INSECURE=1                 (skip verification — lab only)
NODE_CA_FILE=
NODE_TLS_INSECURE=0

# --- PostgreSQL (keys/users) ---
POSTGRES_USER=vlr
POSTGRES_PASSWORD=
POSTGRES_DB=vlr

# --- ClickHouse (metrics) ---
CLICKHOUSE_DB=vlr
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- self-service portal + Authentik (docker-compose.portal.yml) ---
# Public origin that fronts /sub on THIS agent. The portal hands users
# <PUBLIC_SUB_BASE>/sub/<token>. Usually the same as the portal domain.
PUBLIC_SUB_BASE=https://link.infrashark.tech
# Domain the portal Caddy serves (A-record -> this host). LE cert is auto-fetched.
PORTAL_DOMAIN=link.infrashark.tech
# Remote Authentik host the portal forward-auths against (no scheme).
AUTHENTIK_HOST=auth.genomed-security.ru
# Node the portal auto-provisions its users on (register it first: `vlr node connect`).
PORTAL_NODE_ID=ru-yc-msk-01
# Header the Authentik outpost injects (default is fine).
PORTAL_HEADER=X-Authentik-Email
# vlr profile portal users get: "" = plain Reality (all devices), "vision" = mobile.
PORTAL_PROFILE=
# Bearer the Authentik revoke webhook must present. Generate: openssl rand -hex 24
AUTHENTIK_WEBHOOK_SECRET=

# --- subscription presentation (what clients show) ---
# Default overall name (Profile-Title). Supports Cyrillic + emoji (the emoji acts
# as the "icon"). Per-user `title` on create overrides this.
AGENT_SUB_TITLE=🎓 Обучение у Александры Олейник
# How often the client re-fetches the subscription (hours).
AGENT_SUB_UPDATE_HOURS=12
# Optional support link shown in the client.
AGENT_SUB_SUPPORT_URL=

# --- delta-pull tuning (optional) ---
PULL_THRESHOLD_BYTES=268435456
RECONCILE_SECONDS=600
DOWN_AFTER_MISSES=3

# --- telegram subscription-gate bot (../../bot) ---
# Bot from @BotFather. The bot MUST be an admin of the channel, otherwise Telegram
# won't deliver chat_member updates and realtime revoke won't fire (only the sweep).
BOT_TOKEN=
# Channel to gate on: @username or -100<numeric id>.
CHANNEL=
# Invite link shown on the "Subscribe" button.
CHANNEL_INVITE=https://t.me/your_channel
# Agent API as seen by the bot. Same compose -> http://agent:8443 (default).
# Bot on another server -> https://<AGENT_DOMAIN> (and drop depends_on: agent).
AGENT_URL=http://agent:8443
# Node the agent provisions keys on (register it first: `vlr node connect`).
NODE_ID=
# NOTE: the bot reuses PUBLIC_SUB_BASE defined in the portal section above — do
# NOT set it again here (a second definition would override the portal's value).
# Key lifetime: 30d / 12h / empty = no expiry (revoke-on-unsubscribe still applies).
SUB_EXPIRES_IN=
# Per-key name (#fragment) and per-user subscription title (emoji = icon). Optional.
SUB_LABEL=
SUB_TITLE=
# Reconciliation sweep period (seconds).
SWEEP_INTERVAL_SECONDS=600
